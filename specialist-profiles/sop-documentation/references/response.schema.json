{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "selected_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact": {
      "type": "string",
      "pattern": "\\S"
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile_id",
        "owner_skill",
        "status",
        "execution_authorized",
        "evidence",
        "unknowns",
        "result"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "cometweb.specialist-profile-output/v2"
        },
        "profile_id": {
          "const": "sop-documentation",
          "type": "string"
        },
        "owner_skill": {
          "const": "content-writer",
          "type": "string"
        },
        "status": {
          "enum": [
            "DRAFT",
            "BLOCKED",
            "REVIEWABLE"
          ],
          "type": "string"
        },
        "execution_authorized": {
          "const": false,
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "reference",
              "summary"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "USER_INPUT",
                  "OBSERVED",
                  "FRAMEWORK",
                  "HYPOTHESIS"
                ],
                "type": "string"
              },
              "reference": {
                "type": "string",
                "pattern": "\\S"
              },
              "summary": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "minItems": 0
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process",
            "version",
            "owner",
            "prerequisites",
            "steps",
            "exception_handling",
            "quality_checks",
            "framework_source_ids"
          ],
          "properties": {
            "process": {
              "type": "string",
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "pattern": "\\S"
            },
            "owner": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "minItems": 0
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "action",
                  "expected_result",
                  "verification",
                  "source_ids",
                  "risk",
                  "approval_requirement",
                  "basis"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "action": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "expected_result": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "verification": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "uniqueItems": true
                  },
                  "risk": {
                    "enum": [
                      "LOCAL_REVERSIBLE",
                      "EXTERNAL_MUTATION"
                    ],
                    "type": "string"
                  },
                  "approval_requirement": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "enum": [
                      "CONFIRMED",
                      "PROPOSED"
                    ]
                  }
                }
              },
              "minItems": 1
            },
            "exception_handling": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "minItems": 0
            },
            "quality_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "minItems": 1
            },
            "framework_source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  },
  "required": [
    "selected_skills",
    "selected_profile_id",
    "artifact",
    "sidecar"
  ]
}
