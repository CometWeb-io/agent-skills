{
  "description": "CW-AIP v2 conformance cases. Run by tooling/tests/test_cwaip_conformance.py.",
  "cases": [
    {
      "file": "valid/evidence-ready.json",
      "expect": "accept",
      "final": true
    },
    {
      "file": "valid/decision-test.json",
      "expect": "accept",
      "final": true
    },
    {
      "file": "valid/decision-council-no-go.json",
      "expect": "accept",
      "final": true,
      "note": "A Council NO-GO written in the schema spelling (ai-council gate: envelope_verdict)"
    },
    {
      "file": "valid/finding-open.json",
      "expect": "accept",
      "final": true
    },
    {
      "file": "valid/roadmap-baseline.json",
      "expect": "accept",
      "final": true
    },
    {
      "file": "valid/release-go-with-controls.json",
      "expect": "accept",
      "final": true
    },
    {
      "file": "valid/context-portfolio-governance.json",
      "expect": "accept",
      "final": true,
      "note": "profile=portfolio and governance are part of the cometweb-context contract"
    },
    {
      "file": "valid/hash-bare-uppercase-hex.json",
      "expect": "accept",
      "final": true,
      "note": "the sha256: prefix is optional and hex comparison is case-insensitive"
    },
    {
      "file": "valid/draft-pending-hash.json",
      "expect": "accept",
      "final": false,
      "note": "drafts may carry pending outside --final"
    },
    {
      "file": "valid/generated-at-offset.json",
      "expect": "accept",
      "final": true
    },
    {
      "file": "valid/release-no-go-with-blockers.json",
      "expect": "accept",
      "final": true,
      "note": "blockers are expected next to NO_GO"
    },
    {
      "file": "invalid/pending-hash-under-final.json",
      "expect": "reject",
      "final": true,
      "error": "pending"
    },
    {
      "file": "invalid/hash-mismatch.json",
      "expect": "reject",
      "final": false,
      "error": "payload_hash mismatch"
    },
    {
      "file": "invalid/hash-unknown-algorithm.json",
      "expect": "reject",
      "final": false,
      "error": "payload_hash"
    },
    {
      "file": "invalid/core-missing-payload-hash.json",
      "expect": "reject",
      "final": false,
      "error": "payload_hash"
    },
    {
      "file": "invalid/core-unknown-property.json",
      "expect": "reject",
      "final": false,
      "error": "unexpected",
      "note": "extensions belong inside payload"
    },
    {
      "file": "invalid/core-protocol-version-1.json",
      "expect": "reject",
      "final": false,
      "error": "protocol_version"
    },
    {
      "file": "invalid/core-generated-at-without-timezone.json",
      "expect": "reject",
      "final": false,
      "error": "generated_at"
    },
    {
      "file": "invalid/core-generated-at-date-only.json",
      "expect": "reject",
      "final": false,
      "error": "generated_at"
    },
    {
      "file": "invalid/core-sensitivity-uppercase.json",
      "expect": "reject",
      "final": false,
      "error": "sensitivity",
      "note": "v2 enums are lowercase"
    },
    {
      "file": "invalid/core-type-without-payload-schema.json",
      "expect": "reject",
      "final": false,
      "error": "SpecialistHandoff",
      "note": "reserved in the core enum; no v2 payload schema exists yet"
    },
    {
      "file": "invalid/core-dependencies-not-strings.json",
      "expect": "reject",
      "final": false,
      "error": "dependencies"
    },
    {
      "file": "invalid/evidence-verified-inference.json",
      "expect": "reject",
      "final": false,
      "error": "INFERENCE cannot be VERIFIED"
    },
    {
      "file": "invalid/evidence-edge-unknown-source.json",
      "expect": "reject",
      "final": false,
      "error": "unknown source_id"
    },
    {
      "file": "invalid/evidence-duplicate-claim-id.json",
      "expect": "reject",
      "final": false,
      "error": "duplicate claim_id"
    },
    {
      "file": "invalid/evidence-ready-with-blocking-gap.json",
      "expect": "reject",
      "final": false,
      "error": "blocking gaps"
    },
    {
      "file": "invalid/evidence-ready-with-unresolved-contradiction.json",
      "expect": "reject",
      "final": false,
      "error": "unresolved material contradictions"
    },
    {
      "file": "invalid/evidence-unknown-materiality.json",
      "expect": "reject",
      "final": false,
      "error": "materiality"
    },
    {
      "file": "invalid/decision-go-blocked-by-gate.json",
      "expect": "reject",
      "final": false,
      "error": "GO blocked by gate"
    },
    {
      "file": "invalid/decision-go-with-blockers.json",
      "expect": "reject",
      "final": false,
      "error": "GO cannot have blockers"
    },
    {
      "file": "invalid/decision-go-awaiting-human-approval.json",
      "expect": "reject",
      "final": false,
      "error": "human_approval"
    },
    {
      "file": "invalid/decision-release-verdict.json",
      "expect": "reject",
      "final": false,
      "error": "verdict",
      "note": "GO_WITH_CONTROLS is a release verdict, not a decision verdict"
    },
    {
      "file": "invalid/decision-council-hyphen-verdict.json",
      "expect": "reject",
      "final": false,
      "error": "verdict",
      "note": "The Council report spelling NO-GO is not the envelope spelling NO_GO"
    },
    {
      "file": "invalid/finding-unknown-severity.json",
      "expect": "reject",
      "final": false,
      "error": "severity"
    },
    {
      "file": "invalid/finding-missing-status.json",
      "expect": "reject",
      "final": false,
      "error": "status"
    },
    {
      "file": "invalid/roadmap-lowercase-mode.json",
      "expect": "reject",
      "final": false,
      "error": "mode"
    },
    {
      "file": "invalid/roadmap-item-missing-priority.json",
      "expect": "reject",
      "final": false,
      "error": "priority"
    },
    {
      "file": "invalid/release-decision-verdict.json",
      "expect": "reject",
      "final": false,
      "error": "verdict"
    },
    {
      "file": "invalid/release-missing-manifest-hash.json",
      "expect": "reject",
      "final": false,
      "error": "manifest_hash"
    },
    {
      "file": "invalid/context-unknown-profile.json",
      "expect": "reject",
      "final": false,
      "error": "profile"
    },
    {
      "file": "invalid/context-fact-unknown-source.json",
      "expect": "reject",
      "final": false,
      "error": "src-404"
    },
    {
      "file": "invalid/release-go-with-blockers.json",
      "expect": "reject",
      "final": false,
      "error": "GO cannot have blockers"
    },
    {
      "file": "invalid/release-go-with-controls-with-blockers.json",
      "expect": "reject",
      "final": false,
      "error": "GO_WITH_CONTROLS cannot have blockers",
      "note": "GO_WITH_CONTROLS requires no open blocker; controls do not neutralize one"
    },
    {
      "file": "invalid/release-go-with-block-gate.json",
      "expect": "reject",
      "final": false,
      "error": "GO blocked by gate security status=BLOCK",
      "note": "an empty blockers list does not clear a gate that still says BLOCK"
    },
    {
      "file": "invalid/release-go-with-controls-with-block-gate.json",
      "expect": "reject",
      "final": false,
      "error": "GO_WITH_CONTROLS blocked by gate security status=BLOCK",
      "note": "controls bound residual risk; they do not clear a BLOCK gate"
    },
    {
      "file": "invalid/release-go-with-lowercase-block-gate.json",
      "expect": "reject",
      "final": false,
      "error": "GO blocked by gate privacy status=block",
      "note": "release gate statuses are compared case-insensitively; the readiness engine writes governance states in lowercase"
    },
    {
      "file": "invalid/release-go-with-counsel-required-gate.json",
      "expect": "reject",
      "final": false,
      "error": "GO_WITH_CONTROLS blocked by gate legal status=COUNSEL_REQUIRED"
    },
    {
      "file": "valid/release-defer-with-block-gate.json",
      "expect": "accept",
      "final": true,
      "note": "unresolved gates are expected next to DEFER or NO_GO"
    }
  ]
}
