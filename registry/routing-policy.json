  "negation": {"note": "Clause-scoped negation for routing signals only. A signal match whose start lies after a cue and before the end of that clause does not score. Explicit invocations, denied_patterns and narrow_intent_guards are unaffected. See evals/routing/README.md.", "cues": ["^\\s{0,3}(?:(?:please|pls|ok|okay|so|now|prosze|teraz|na razie)\\s{1,3}){0,2}(?:do not|don['’]?t|dont|never|skip|no(?=\\s)|nie)\\b", "\\b(?:(?:do not|don['’]?t|dont)\\s{1,3}(?:want|need|have to)|no need to|not necessary to)\\b", "\\b(?:instead of|rather than|zamiast)\\b", "\\bnie\\s{1,3}(?:chce|chcemy|potrzebuje|potrzebujemy|trzeba|musisz|rob|robcie|zrob|uzywaj|uruchamiaj|odpalaj|przeprowadzaj|roastuj|piecz|recenzuj|audytuj|sprawdzaj|przegladaj|oceniaj|ruszaj|zmieniaj)\\b"], "boundary": "[.;:!?,()\\[\\]]|\\s-\\s|[–—]|\\b(?:but|just|only|instead(?! of)|then|and|until|unless|before|after|once|if|when|while|so that|tylko|jedynie|ale|lecz|natomiast|potem|nastepnie|i|oraz|zanim|dopoki|az|jesli|jezeli|gdy|kiedy|chyba ze)\\b", "max_scope_chars": 80},
  "dismissed": {"note": "A clause that says an activity is already done or not wanted names a skill without asking for it. A skill whose every matching routing signal lies in such a clause is demoted: it is left out of the scores, the near-tie rule and the lexical ranker, which reads the text without those clauses. A skill with any signal outside them keeps its whole score. Explicit invocations, denied_patterns and narrow_intent_guards are unaffected. Clauses are cut with negation.boundary. See evals/routing/README.md.", "cues": ["\\b(?:we|i|you|they)\\s{1,3}(?:already\\s{1,3})?(?:did|ran|had|got|finished|completed|have\\s{1,3}(?:done|had|run))\\s{1,3}(?:the|a|an|our|your|that|this|one|its|another)?\\s{0,3}(?:(?!(?:so|now|please|pls|can|could|would|should|to|wiec|teraz|prosze)\\s)[\\w'’-]{1,20}\\s{1,3}){0,3}?\\b(?:re-?)?(?:review|roast|audit|teardown|critique|click.through|walk.?through|qa pass|fact.check|recenzj|przeglad|audyt|analiz)\\w{0,4}\\b", "\\b(?:re-?)?(?:review|roast|audit|teardown|critique|click.through|walk.?through|qa pass|fact.check|recenzj|przeglad|audyt|analiz)\\w{0,4}\\b.{0,40}\\b(?:is|are|was|were|has been|have been)\\s{1,3}(?:already\\s{1,3})?(?:done|finished|complete|completed|over|behind us)\\b", "\\b(?:is|are|was|were|has been|have been)\\s{1,3}already\\s{1,3}(?:reviewed|roasted|audited|critiqued|fact.checked|torn apart)\\b", "\\b(?:re-?)?(?:review|roast|audit|teardown|critique|click.through|walk.?through|qa pass|fact.check|recenzj|przeglad|audyt|analiz)\\w{0,4}\\b.{0,50}\\b(?:is|are|was|were)(?:\\s{1,3}not|n['’]?t)\\s{1,3}(?:needed|necessary|required|wanted|the point|the goal|what i (?:want|need|asked for))\\b", "\\b(?:not|n['’]?t)\\s{1,3}(?:asking|looking)\\s{1,3}for\\b", "\\b(?:goal|point|ask|idea|task)\\s{1,3}(?:here\\s{1,3})?(?:is|was)\\s{1,3}not\\b", "\\b(?:re-?)?(?:review|roast|audit|teardown|critique|click.through|walk.?through|qa pass|fact.check|recenzj|przeglad|audyt|analiz)\\w{0,4}\\b.{0,50}\\b(?:juz\\s{1,3}(?:mielismy|mialem|mialam|