{
  "schema": "cometweb.runtime-hosts/v1",
  "hosts": {
    "claude": {
      "runtime_mode": "executable",
      "binary": "claude",
      "config_env": "CLAUDE_CONFIG_DIR",
      "credential_env": [
        "ANTHROPIC_API_KEY",
        "CLAUDE_CODE_OAUTH_TOKEN"
      ],
      "adapter": "claude-stream",
      "native_budget": true
    },
    "codex": {
      "runtime_mode": "executable",
      "binary": "codex",
      "config_env": "CODEX_HOME",
      "credential_env": [
        "OPENAI_API_KEY",
        "CODEX_API_KEY"
      ],
      "adapter": "codex-json",
      "native_budget": false
    },
    "cursor": {
      "runtime_mode": "not_run",
      "credential_env": [],
