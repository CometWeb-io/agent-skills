{
  "schema": "cometweb.hosts/v1",
  "hosts": {
    "agentskills-common": {
      "frontmatter_keys": ["name", "description"],
      "name_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description_min": 80,
      "description_max": 2048
    },
    "openai-codex": {
      "description_max": 1024,
      "agents_file": "agents/openai.yaml",
      "recommended_interface_keys": [
        "display_name",
        "short_description",
        "default_prompt"
      ]
    },
    "chatgpt": {
      "description_max": 1024,
      "agents_file": "agents/openai.yaml"
    },
    "claude-code": {
      "description_max": 2048
    },
    "cursor": {
      "description_max": 2048,
      "optional_extras": ["extras/cursor-rule.mdc"]
    },
    "package": {
      "required_files": ["SKILL.md", "VERSION", "LICENSE"]
    }
  }
}
