{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/cw-aip/v2/evidence.schema.json",
  "title": "CW-AIP v2 EvidenceEnvelope payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "research_contract",
    "mode",
    "as_of",
    "material_claims",
    "sources",
    "evidence_edges",
    "gaps",
    "contradictions",
    "readiness",
    "evidence_pack_hash"
  ],
  "properties": {
    "schema": { "const": "cometweb.evidence/v2" },
    "research_contract": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["QUICK", "STANDARD", "DEEP"] },
    "as_of": { "type": "string", "minLength": 1 },
    "material_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["claim_id", "text", "epistemic_kind", "status", "materiality"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "epistemic_kind": { "type": "string", "enum": ["FACT", "INFERENCE"] },
          "status": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "enum": ["assumption", "framework_method", "user_supplied", "verified_fact"] },
          "scope": { "type": "object", "minProperties": 1 },
          "materiality": {
            "type": "string",
            "enum": ["critical", "material", "supporting"]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["source_id"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["edge_id", "claim_id", "source_id", "direction", "admission"],
        "properties": {
          "edge_id": { "type": "string" },
          "basis": { "type": "string", "enum": ["assumption", "framework_method", "user_supplied", "verified_fact"] },
          "claim_id": { "type": "string" },
          "source_id": { "type": "string" },
          "direction": {
            "type": "string",
            "enum": ["SUPPORT", "CONTRADICT", "CONTEXT"]
          },
          "admission": {
            "type": "string",
            "enum": ["ACCEPTED", "CONTEXT_ONLY", "REJECTED"]
          }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "object" } },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["resolved", "unresolved"] },
          "resolution": { "type": "string", "enum": ["RESOLVED_SCOPE", "RESOLVED_TIME", "RESOLVED_DEFINITION", "RESOLVED_METHOD", "RESOLVED_SUPERSEDED", "RESOLVED_AUTHORITY", "UNRESOLVED"] },
          "materiality": { "type": "string", "enum": ["critical", "material", "supporting"] },
          "severity": { "type": "string", "enum": ["critical", "material", "supporting"] }
        },
        "allOf": [
          { "anyOf": [{ "required": ["status"] }, { "required": ["resolution"] }] },
          { "anyOf": [{ "required": ["materiality"] }, { "required": ["severity"] }] }
        ]
      }
    },
    "readiness": {
      "type": "string",
      "enum": ["READY", "NOT_READY", "DEFER"]
    },
    "evidence_pack_hash": { "type": "string", "minLength": 1 },
    "handoff": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "recommended_next_skill": { "type": ["string", "null"] },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "readiness": { "const": "READY" } } },
      "then": {
        "properties": {
          "material_claims": {
            "items": {
              "if": { "properties": { "materiality": { "enum": ["critical", "material"] } } },
              "then": { "allOf": [
                { "if": { "properties": { "epistemic_kind": { "const": "FACT" } } },
                  "then": { "properties": { "status": { "const": "VERIFIED" } } } },
                { "if": { "properties": { "epistemic_kind": { "const": "INFERENCE" } } },
                  "then": { "properties": { "status": { "enum": ["SUPPORTED", "SUPPORTED_INFERENCE"] } } } }
              ] }
            }
          }
        }
      }
    }
  ]
}
