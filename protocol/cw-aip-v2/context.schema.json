{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/cw-aip/v2/context.schema.json",
  "title": "CW-AIP v2 ContextEnvelope payload (cometweb.context/v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "generated_at",
    "goal",
    "mode",
    "profile",
    "baseline",
    "sources",
    "facts",
    "deltas",
    "conflicts",
    "gaps",
    "blocked_public_claims",
    "handoff"
  ],
  "properties": {
    "schema": { "const": "cometweb.context/v2" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "goal": { "type": "string", "minLength": 1 },
    "mode": {
      "type": "string",
      "enum": ["targeted", "standard", "delta", "full"]
    },
    "profile": {
      "type": "string",
      "enum": [
        "product",
        "gtm",
        "outreach",
        "brand",
        "meeting",
        "weekly",
        "claim-verification",
        "custom"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "unavailable", "not_requested"]
        },
        "ref": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "deltas": {
      "type": "array",
      "items": { "$ref": "#/$defs/delta" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "blocked_public_claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocked_claim" }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_next_skill", "dependencies", "constraints"],
      "properties": {
        "recommended_next_skill": { "type": ["string", "null"] },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "authority",
        "access",
        "retrieved_at",
        "freshness",
        "sensitivity",
        "summary",
        "evidence_ref"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_type": {
          "type": "string",
          "enum": [
            "github",
            "local-repo",
            "vault",
            "notion",
            "crm",
            "gmail",
            "calendar",
            "insight",
            "website",
            "social",
            "file",
            "other"
          ]
        },
        "authority": {
          "type": "string",
          "enum": [
            "system_of_record",
            "canonical",
            "primary",
            "secondary",
            "fallback"
          ]
        },
        "access": {
          "type": "string",
          "enum": ["live", "local", "connector", "cached", "fallback"]
        },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "effective_at": { "type": ["string", "null"], "format": "date-time" },
        "freshness": {
          "type": "string",
          "enum": ["fresh", "aging", "stale", "unknown"]
        },
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "summary": { "type": "string" },
        "evidence_ref": { "type": "string" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "statement",
        "source_ids",
        "confidence",
        "sensitivity"
      ],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["delta_id", "statement"],
      "properties": {
        "delta_id": { "type": "string" },
        "statement": { "type": "string" },
        "source_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": true,
      "required": ["conflict_id", "status", "statements"],
      "properties": {
        "conflict_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["unresolved", "resolved"]
        },
        "statements": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "object" }
        },
        "basis": { "type": ["string", "null"] }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gap_id", "kind", "statement"],
      "properties": {
        "gap_id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "unavailable_source",
            "authority_gap",
            "incomplete_scope",
            "unverifiable_claim",
            "other"
          ]
        },
        "statement": { "type": "string" },
        "missing_authority": { "type": ["string", "null"] }
      }
    },
    "blocked_claim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claim", "reason"],
      "properties": {
        "claim": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
