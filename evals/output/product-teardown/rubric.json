{
  "skill": "product-teardown",
  "contract": "skills/product-teardown/references/output-contract.md",
  "ordered_sections": true,
  "sections": [
    {"id": "executive", "title": "Executive verdict", "aliases": ["executive verdict"], "required": true},
    {"id": "source-map", "title": "Source/version map", "aliases": ["source/version map", "source / version map", "source and version map"], "required": true},
    {"id": "destination-map", "title": "Destination problem map", "aliases": ["destination problem map"]},
    {"id": "flow-map", "title": "Relevant system/flow map", "aliases": ["relevant system", "system/flow map"]},
    {"id": "portfolio", "title": "Pattern portfolio / pattern families", "aliases": ["pattern portfolio", "pattern families"], "required": true},
    {"id": "packets", "title": "Implementation transfer packets", "aliases": ["implementation transfer packets"], "required": true},
    {"id": "rejected", "title": "Rejected patterns / false friends", "aliases": ["rejected patterns", "false friends"], "required": true},
    {"id": "unknowns", "title": "Unknowns that can change a verdict", "aliases": ["unknowns"], "required": true},
    {"id": "handoff", "title": "Handoff packet", "aliases": ["handoff"]}
  ],
  "checks": [
    {"type": "doc_require", "rule": "shape", "section": "executive",
     "pattern": "Shape:\\s*`?(?:SOURCE_ONLY|SOURCE_TO_TARGET|MULTI_SOURCE_TO_TARGET)\\b",
     "message": "the executive verdict does not state the shape (SOURCE_ONLY | SOURCE_TO_TARGET | MULTI_SOURCE_TO_TARGET)"},
    {"type": "doc_require", "rule": "mode", "section": "executive",
     "pattern": "Mode:\\s*`?(?:SNAPSHOT|STANDARD|DEEP)\\b",
     "message": "the executive verdict does not state the mode (SNAPSHOT | STANDARD | DEEP)"},
    {"type": "doc_require", "rule": "action-mix", "section": "executive",
     "pattern": "Action mix:[^\\n]*\\d+\\s+(?:ADOPT|EXPERIMENT|CANDIDATE|BACKLOG|REJECT|REVIEW_REQUIRED)\\b",
     "message": "the executive verdict has no action mix (counts per verdict)"},
    {"type": "doc_require", "rule": "mandatory-blockers", "section": "executive",
     "pattern": "Mandatory blockers:\\s*\\S",
     "message": "the executive verdict does not state the mandatory blockers (or 'none')"},
    {"type": "doc_forbid", "rule": "destination-map", "code": "SECTION_MISSING",
     "pattern": "(?s)\\A(?!.*^#{1,6}\\s*(?:\\d+[.)]\\s*)?Destination problem map).*Shape:\\s*`?(?:MULTI_)?SOURCE_TO_TARGET\\b",
     "message": "a SOURCE_TO_TARGET teardown needs the Destination problem map section"},
    {"type": "doc_forbid", "rule": "buried-review-required", "code": "CONTRACT_VIOLATION",
     "pattern": "(?s)Mandatory blockers:\\s*(?:none|-|n/a)\\b.*Verdict:\\s*`?REVIEW_REQUIRED\\b",
     "message": "a REVIEW_REQUIRED pattern must be surfaced as a mandatory blocker in the executive verdict"},
    {"type": "doc_forbid", "rule": "source-only-adopt", "code": "CONTRACT_VIOLATION",
     "pattern": "(?s)Shape:\\s*`?SOURCE_ONLY\\b.*Verdict:\\s*`?(?:ADOPT|EXPERIMENT)\\b",
     "message": "SOURCE_ONLY has no destination evidence, so no pattern can be ADOPT or EXPERIMENT"},
    {"type": "items_require", "rule": "pattern-evidence", "section": "portfolio",
     "pattern": "^\\s*(?:[-*]\\s*)?Evidence:\\s*`?E-\\d{3}\\b", "code": "EVIDENCE_MISSING",
     "message": "a pattern card cites no source evidence ID (E-NNN)"},
    {"type": "items_require", "rule": "destination-evidence", "section": "portfolio",
     "when_item": "Verdict:\\s*`?(?:ADOPT|EXPERIMENT)\\b",
     "pattern": "Destination problem evidence:\\s*`?E-\\d{3}\\b", "code": "EVIDENCE_MISSING",
     "message": "ADOPT and EXPERIMENT need destination problem evidence (E-NNN)"},
    {"type": "items_require", "rule": "verdict-token", "section": "portfolio",
     "pattern": "Verdict:\\s*`?(?:CANDIDATE|ADOPT|EXPERIMENT|BACKLOG|REJECT|REVIEW_REQUIRED)\\b", "code": "VERDICT_INVALID",
     "message": "a pattern card has no verdict from CANDIDATE | ADOPT | EXPERIMENT | BACKLOG | REJECT | REVIEW_REQUIRED"},
    {"type": "items_require", "rule": "mechanism", "section": "portfolio",
     "pattern": "Mechanism(?: hypothesis)?:\\s*\\S", "code": "CONTRACT_VIOLATION",
     "message": "a pattern card has no mechanism hypothesis; a feature list is not a pattern"},
    {"type": "items_require", "rule": "gates-stated", "section": "portfolio",
     "pattern": "Gates:\\s*\\S", "code": "CONTRACT_VIOLATION",
     "message": "a pattern card does not state its legal_ip / security_privacy gates"},
    {"type": "items_forbid", "rule": "adopt-with-open-gate", "section": "portfolio",
     "when_item": "Verdict:\\s*`?(?:ADOPT|EXPERIMENT)\\b",
     "pattern": "Gates:[^\\n]*\\b(?:review|block|unknown)\\b", "code": "VERDICT_WITH_BLOCKERS",
     "message": "ADOPT/EXPERIMENT next to an unresolved legal/IP or security/privacy gate; use REVIEW_REQUIRED"},
    {"type": "items_require", "rule": "experiment-validation", "section": "portfolio",
     "when_item": "Verdict:\\s*`?EXPERIMENT\\b", "pattern": "Validation:[^\\n]*\\bkill\\b", "code": "CONTRACT_VIOLATION",
     "message": "an EXPERIMENT needs a falsifiable validation with kill criteria"},
    {"type": "doc_forbid", "rule": "causal-overclaim",
     "pattern": "\\b(?:drove|drives|is why|proves? (?:that )?(?:it|this|the (?:pattern|mechanism)) works|guarantees? (?:a |an )?(?:lift|increase|uplift))\\b",
     "message": "causal outcome claims need outcome evidence; state the mechanism as a hypothesis"},
    {"type": "doc_forbid", "rule": "prevalence-as-proof",
     "pattern": "\\b(?:most|all|every)\\b[^.\\n]{0,50}\\b(?:use|uses|ship|ships|have|has)\\b[^.\\n]{0,50}\\b(?:so|therefore|which proves|proving)\\b[^.\\n]{0,40}\\b(?:works|effective|converts)\\b",
     "message": "multi-source prevalence is not proof of effectiveness"}
  ],
  "ids": [
    {"rule": "pattern-ids", "pattern": "\\bPT-\\d{3}\\b",
     "defined_in": [{"section": "portfolio", "as": "subheading"}],
     "refs_json": ["patterns[*].id", "patterns[*].interactions.requires[*]", "patterns[*].interactions.conflicts_with[*]",
                   "patterns[*].interactions.enables[*]", "patterns[*].interactions.substitutes_for[*]", "patterns[*].interactions.bundles_with[*]"],
     "defined_by": "no '### PT-NNN' pattern card with that ID is in the pattern portfolio"},
    {"rule": "evidence-ids", "pattern": "\\bE-\\d{3}\\b",
     "defined_in": [{"json": "evidence[*].evidence_id", "when": {"schema_version": "2.0"}}],
     "defined_by": "the ledger's evidence[] has no entry with that evidence_id"},
    {"rule": "source-ids", "pattern": "\\bSRC-\\d+\\b",
     "defined_in": [{"json": "source_targets[*].id", "when": {"schema_version": "2.0"}}],
     "defined_by": "the ledger's source_targets[] has no target with that id"}
  ],
  "sidecars": [
    {"rule": "pattern-ledger-v2", "detect": {"has_keys": ["patterns", "evidence"], "equals": {"schema_version": "2.0"}},
     "validator": "skills/product-teardown/scripts/validate_pattern_ledger.py", "function": "validate"}
  ]
}
