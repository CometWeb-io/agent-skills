{
  "skill": "content-roaster",
  "contract": "skills/content-roaster/references/output-contract.md",
  "ordered_sections": true,
  "sections": [
    {"id": "what-content", "title": "What this content is trying to make the reader believe/do", "aliases": ["what this content"], "required": true},
    {"id": "first-attack", "title": "First thing a skeptical reader attacks", "aliases": ["first thing"], "required_when_verdict": ["MATERIAL_FINDINGS"]},
    {"id": "findings", "title": "Material roast findings", "aliases": ["material roast findings", "material findings", "findings"], "required": true},
    {"id": "root-causes", "title": "Root causes", "aliases": ["root causes"]},
    {"id": "proof-debt", "title": "Proof debt / verification queue", "aliases": ["proof debt", "verification queue"], "required": true},
    {"id": "revision-ledger", "title": "Revision ledger", "aliases": ["revision ledger"]},
    {"id": "survives", "title": "What survives", "aliases": ["what survives"], "required": true},
    {"id": "core-fix", "title": "Core fix", "aliases": ["core fix"], "required": true}
  ],
  "verdict": {
    "tokens": ["MATERIAL_FINDINGS", "NO_MATERIAL_FINDINGS", "INSUFFICIENT_EVIDENCE"],
    "authorizing": ["NO_MATERIAL_FINDINGS", "INSUFFICIENT_EVIDENCE"],
    "required": false,
    "primary": {"line": "^\\s*[-*]?\\s*\\**(?:Review )?Outcome\\**\\s*:"},
    "json": [
      {"rule": "sidecar-outcome", "path": "review_outcome", "when": {"schema": "cometweb.content-roaster/v6"}}
    ]
  },
  "blockers": [
    {"rule": "listed-finding", "type": "section_items", "section": "findings",
     "none_pattern": "^(?:none|no material finding)"}
  ],
  "checks": [
    {"type": "items_require", "rule": "finding-anchor", "section": "findings", "none_pattern": "^(?:none|no material finding)",
     "pattern": "Anchor:\\s*\\S", "code": "EVIDENCE_MISSING", "message": "a finding quotes no anchor from the reviewed content"},
    {"type": "items_require", "rule": "finding-evidence", "section": "findings", "none_pattern": "^(?:none|no material finding)",
     "pattern": "\\bEV-\\d+\\b", "code": "EVIDENCE_MISSING", "message": "a finding cites no evidence ref (EV-NN)"},
    {"type": "items_require", "rule": "diagnosis", "section": "findings", "none_pattern": "^(?:none|no material finding)",
     "pattern": "\\bDX-\\d+\\b", "code": "CONTRACT_VIOLATION",
     "message": "a finding does not reference its diagnosis (DX-NN) before prescribing a repair"},
    {"type": "items_require", "rule": "severity", "section": "findings", "none_pattern": "^(?:none|no material finding)",
     "pattern": "\\A[^\\n]*\\b(?:BLOCKER|MAJOR|MINOR)\\b", "code": "CONTRACT_VIOLATION",
     "message": "a finding heading carries no severity (BLOCKER | MAJOR | MINOR)"},
    {"type": "items_require", "rule": "blocker-admission", "section": "findings",
     "when_item": "\\A[^\\n]*\\bBLOCKER\\b", "pattern": "Falsifier[^\\n]*SURVIVES",
     "code": "CONTRACT_VIOLATION", "message": "a BLOCKER must survive a recorded falsifier pass"},
    {"type": "items_require", "rule": "verification", "section": "findings", "none_pattern": "^(?:none|no material finding)",
     "pattern": "(?:Verification|Acceptance):\\s*\\S", "code": "CONTRACT_VIOLATION",
     "message": "a finding has no falsifiable verification contract"},
    {"type": "doc_forbid", "rule": "authorship-claim",
     "pattern": "\\b(?:AI-written|written by (?:AI|ChatGPT|an LLM)|obviously AI|generated by AI)\\b",
     "message": "an authorship claim is not evidence about the content; review what the text does"},
    {"type": "doc_forbid", "rule": "personal-attack",
     "pattern": "\\b(?:author|writer|copywriter|you|your team)\\b.{0,40}\\b(?:stupid|idiot|moron|lazy|incompetent|clueless|fraud)\\b",
     "message": "attack the content, not the people"}
  ],
  "ids": [
    {"rule": "finding-ids", "pattern": "\\bCR-\\d{3}\\b",
     "defined_in": [{"section": "findings", "as": "subheading"}],
     "refs_json": ["findings[*].id", "outcome_basis.surviving_finding_ids[*]", "first_attack_id"],
     "defined_by": "no '### CR-NNN' finding with that ID is in the findings section"},
    {"rule": "root-cause-ids", "pattern": "\\bRC-\\d+\\b",
     "defined_in": [{"section": "root-causes", "as": "list_lead"}],
     "refs_json": ["root_causes[*].id"],
     "defined_by": "Root causes declares no root cause with that ID"},
    {"rule": "proof-debt-ids", "pattern": "\\bPD-\\d+\\b",
     "defined_in": [{"section": "proof-debt", "as": "list_lead"}],
     "refs_json": ["proof_debt_ledger[*].id"],
     "defined_by": "the proof-debt queue declares no item with that ID"},
    {"rule": "evidence-ids", "pattern": "\\bEV-\\d+\\b",
     "defined_in": [{"json": "evidence_register[*].id", "when": {"schema": "cometweb.content-roaster/v6"}}],
     "defined_by": "the v6 evidence_register has no entry with that ID"},
    {"rule": "diagnosis-ids", "pattern": "\\bDX-\\d+\\b",
     "defined_in": [{"json": "diagnosis_ledger[*].id", "when": {"schema": "cometweb.content-roaster/v6"}}],
     "defined_by": "the v6 diagnosis_ledger has no entry with that ID"},
    {"rule": "claim-ids", "pattern": "\\bCL-\\d+\\b",
     "defined_in": [{"json": "claim_map[*].id", "when": {"schema": "cometweb.content-roaster/v6"}}],
     "defined_by": "the v6 claim_map has no claim with that ID"}
  ],
  "sidecars": [
    {"rule": "content-roast-v6", "detect": {"equals": {"schema": "cometweb.content-roaster/v6"}},
     "validator": "skills/content-roaster/scripts/validate_roast.py", "function": "validate"}
  ]
}
