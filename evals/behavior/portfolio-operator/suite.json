{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "portfolio-operator",
  "description": "Offline behavior of scripts/portfolio_kernel.py (rank, conflicts, validate, render) as SKILL.md, references/portfolio-model.md, references/prioritization.md and references/output-contract.md document it.",
  "cases": [
    {
      "id": "rank-gates-before-score",
      "kind": "accept",
      "behavior": "Ranking puts the hard external commitment first and a future gate last, ordering by score only inside a gate class.",
      "run": [
        "scripts/portfolio_kernel.py",
        "rank",
        "--items-json",
        "{tmp}/items.json"
      ],
      "files": {
        "items.json": [
          {
            "id": "client-fix",
            "project": "alpha",
            "domain": "CLIENT",
            "commitment_type": "hard_external",
            "effort_class": "M",
            "days_to_deadline": 2,
            "deadline": "2026-09-12",
            "goal_alignment": 4,
            "revenue": 5,
            "trust": 5,
            "blocks_current_goal": true
          },
          {
            "id": "research-note",
            "project": "beta",
            "domain": "RESEARCH",
            "commitment_type": "optional",
            "effort_class": "S",
            "goal_alignment": 2,
            "learning": 3
          },
          {
            "id": "paid-beta-gate",
            "project": "gamma",
            "domain": "PRODUCT",
            "commitment_type": "strategic",
            "effort_class": "L",
            "future_gate": true,
            "goal_alignment": 5
          },
          {
            "id": "old-idea",
            "project": "delta",
            "domain": "GROWTH",
            "commitment_type": "optional",
            "pause": true
          }
        ]
      },
      "expect": {
        "exit_code": 0,
        "json": {
          "0.id": "client-fix",
          "0.gate_rank": 0,
          "0.priority_score": 128.0,
          "1.id": "research-note",
          "1.gate_rank": 4,
          "2.id": "old-idea",
          "2.gate_rank": 4,
          "3.id": "paid-beta-gate",
          "3.gate_rank": 5
        },
        "json_len": {
          "$": 4
        }
      }
    },
    {
      "id": "rank-rejects-unknown-commitment-type",
      "kind": "refuse",
      "behavior": "An unknown commitment_type is an input error with exit 2 that names the item and the allowed values.",
      "run": [
        "scripts/portfolio_kernel.py",
        "rank",
        "--items-json",
        "{tmp}/items.json"
      ],
      "files": {
        "items.json": [
          {
            "id": "x",
            "commitment_type": "maybe"
          }
        ]
      },
      "expect": {
        "exit_code": 2,
        "stderr_contains": [
          "x: commitment_type 'maybe' is not one of hard_external, hard_internal, strategic, optional"
        ]
      }
    },
    {
      "id": "same-day-large-hard-commitments-conflict",
      "kind": "accept",
      "behavior": "Two large hard commitments due the same day are flagged as an overlap instead of assuming capacity is enough.",
      "run": [
        "scripts/portfolio_kernel.py",
        "conflicts",
        "--items-json",
        "{tmp}/items.json"
      ],
      "files": {
        "items.json": [
          {
            "id": "a",
            "project": "alpha",
            "commitment_type": "hard_external",
            "deadline": "2026-09-12",
            "effort_class": "L"
          },
          {
            "id": "b",
            "project": "beta",
            "commitment_type": "hard_internal",
            "deadline": "2026-09-12",
            "effort_class": "L"
          }
        ]
      },
      "expect": {
        "exit_code": 0,
        "json": {
          "$": [
            {
              "type": "HARD_COMMITMENT_OVERLAP",
              "deadline": "2026-09-12",
              "item_ids": [
                "a",
                "b"
              ],
              "reason": "Multiple large hard commitments share the same deadline; capacity cannot be assumed sufficient."
            }
          ]
        }
      }
    },
    {
      "id": "no-overlap-no-conflict",
      "kind": "boundary",
      "behavior": "A portfolio with a single hard commitment reports no capacity conflict.",
      "run": [
        "scripts/portfolio_kernel.py",
        "conflicts",
        "--items-json",
        "{tmp}/items.json"
      ],
      "files": {
        "items.json": [
          {
            "id": "client-fix",
            "project": "alpha",
            "domain": "CLIENT",
            "commitment_type": "hard_external",
