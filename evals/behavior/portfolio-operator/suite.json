          }
        ]
      },
      "expect": {
        "exit_code": 0,
        "json": {
          "$": []
        }
      }
    },
    {
      "id": "valid-report-passes",
      "kind": "accept",
      "behavior": "An outcome-level MUST DO with done_when and evidence and a delegation to a known specialist validates cleanly.",
      "run": [
        "scripts/portfolio_kernel.py",
        "validate",
        "--report-json",
        "{tmp}/portfolio-report.json"
      ],
      "files": {
        "portfolio-report.json": {
          "protocol_version": "1.0",
          "as_of": "2026-09-10T10:00:00+02:00",
          "horizon": "14d",
          "primary_goal": "Ship the client fix",
          "capacity": {
            "source": "unknown"
          },
          "readiness": {
            "status": "PROVISIONAL",
            "reason": "calendar not connected"
          },
          "must_do": [
            {
              "id": "client-fix",
              "scope_level": "portfolio",
              "portfolio_outcome": "Client fix delivered and accepted",
              "done_when": "client confirms the fix in writing",
              "evidence": [
                "contract clause on file"
              ],
              "commitment_type": "hard_external",
              "blocks_current_goal": true
            }
          ],
          "capacity_conflicts": [],
          "now": [],
          "delegate": [
            {
              "id": "release-check",
              "question": "Is the fix build ready to ship?",
              "return_contract": "GO or NO_GO with evidence",
              "delegate_to": "release-readiness"
            }
          ],
          "delegate_candidate": [],
          "waiting": [],
          "pause_drop": [],
          "next": [],
          "decision_now": []
        }
      },
      "expect": {
        "exit_code": 0,
        "json": {
          "valid": true,
          "errors": []
        }
      }
    },
    {
      "id": "report-invariants-enforced",
      "kind": "refuse",
      "behavior": "Invented capacity hours, a NOW item without done_when or evidence, a non-blocking future gate in MUST DO and an unproven external delegate all fail validation.",
      "run": [
        "scripts/portfolio_kernel.py",
        "validate",
        "--report-json",
        "{tmp}/portfolio-report.json"
      ],
      "files": {
        "portfolio-report.json": {
          "protocol_version": "1.0",
          "as_of": "2026-09-10T10:00:00+02:00",
          "horizon": "14d",
          "primary_goal": "Ship the client fix",
          "capacity": {
            "source": "unknown",
            "hours": 20
          },
          "readiness": {
            "status": "PROVISIONAL",
            "reason": "calendar not connected"
          },
          "must_do": [
            {
              "id": "client-fix",
              "scope_level": "portfolio",
              "portfolio_outcome": "Client fix delivered and accepted",
              "done_when": "client confirms the fix in writing",
              "evidence": [
                "contract clause on file"
              ],
              "commitment_type": "hard_external",
              "blocks_current_goal": true
            },
            {
              "id": "beta-gate",
              "scope_level": "portfolio",
              "portfolio_outcome": "Paid beta gate passed",
              "done_when": "gate passed",
              "evidence": [
                "plan"
              ],
              "future_gate": true
            }
          ],
          "capacity_conflicts": [],
          "now": [
            {
              "id": "x",
              "action": "Write the launch post"
            }
          ],
          "delegate": [
            {
              "id": "release-check",
              "question": "Is the fix build ready to ship?",
              "return_contract": "GO or NO_GO with evidence",
              "delegate_to": "release-readiness"
            },
            {
              "id": "y",
              "question": "Can the agency redo the logo?",
              "return_contract": "quote",
              "delegate_to": "Example Agency"
            }
          ],
          "delegate_candidate": [],
          "waiting": [],
          "pause_drop": [],
          "next": [],
          "decision_now": []
        }
      },
      "expect": {
        "exit_code": 1,
        "json": {
          "valid": false,
          "errors": [
            "capacity.hours must be absent when capacity source is unknown",
            "now[0].done_when is required",
            "now[0].evidence is required",
            "future gate cannot appear in must_do unless it blocks the current goal",
            "delegate[1] violates delegate reality gate: external person/agent/system requires delegate_evidence_ref or user_defined=true; otherwise use delegate_candidate or pause"
          ]
        }
      }
    },
