    {
      "id": "non-object-report-is-invalid",
      "kind": "refuse",
      "behavior": "A report file that holds a JSON list fails validation with a named error instead of a traceback.",
      "run": [
        "scripts/portfolio_kernel.py",
        "validate",
        "--report-json",
        "{tmp}/portfolio-report.json"
      ],
      "files": {
        "portfolio-report.json": "[]"
      },
      "expect": {
        "exit_code": 1,
        "json": {
          "valid": false,
          "errors": [
            "report must be a JSON object"
          ]
        }
      }
    },
