{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "quality-loop-operator",
  "description": "Offline behavior of the run-state kernel the references document as validate(payload) in scripts/kernel.py, and of the bundled eval runner.",
  "cases": [
    {
      "id": "all-editorial-stages-passed-is-complete",
      "kind": "accept",
      "behavior": "An editorial run whose every stage passed, ending in acceptance, is COMPLETE.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "validate",
      "args": [
        {
          "profile": "EDITORIAL",
          "candidate_id": "guide-v2",
          "contract_id": "brief-1",
          "stages": [
            {
              "skill": "brief-architect",
              "state": "PASS"
            },
            {
              "skill": "content-writer",
              "state": "PASS"
            },
            {
              "skill": "content-reviewer",
              "state": "PASS"
            },
            {
              "skill": "content-roaster",
              "state": "PASS"
            },
            {
              "skill": "repair-operator",
              "state": "PASS"
            },
            {
              "skill": "artifact-acceptance",
              "state": "PASS"
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "COMPLETE",
          "next_stage": null,
          "errors": [],
          "unresolved_conflicts": 0,
          "blocking_quality_debt": 0
        }
      }
    },
