    {
      "id": "measured-improvement-goes-to-canary",
      "kind": "accept",
      "behavior": "A skill candidate with a measured improvement on a hash-bound rubric and benchmark moves to canary rollout.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "validate",
      "args": [
        {
          "profile": "SKILL_QUALITY",
          "candidate_id": "guide-v2",
          "contract_id": "brief-1",
          "stages": [
            {
              "skill": "skill-auditor",
              "state": "PASS"
            },
            {
              "skill": "rubric-designer",
              "state": "PASS",
              "rubric_hash": "1111111111111111111111111111111111111111111111111111111111111111"
            },
            {
              "skill": "benchmark-curator",
              "state": "PASS",
              "rubric_hash": "1111111111111111111111111111111111111111111111111111111111111111",
              "benchmark_hash": "2222222222222222222222222222222222222222222222222222222222222222"
            },
            {
              "skill": "skill-evaluator",
              "state": "PASS",
              "rubric_hash": "1111111111111111111111111111111111111111111111111111111111111111",
              "benchmark_hash": "2222222222222222222222222222222222222222222222222222222222222222",
              "result": "IMPROVED"
            }
          ],
          "runtime_lifecycle": {
            "state": "READY_FOR_CANARY",
            "material_change": true,
            "rollback_version": "1.4.0"
          }
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "READY_FOR_ROLLOUT",
          "next_stage": "canary",
          "errors": [],
          "unresolved_conflicts": 0,
          "blocking_quality_debt": 0,
          "skill_evaluation_result": "IMPROVED",
          "rollout_status": "READY_FOR_CANARY"
        }
      }
    },
