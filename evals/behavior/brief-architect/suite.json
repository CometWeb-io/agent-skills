      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "INVALID",
          "missing": [],
          "errors": [
            "evidence_policy:invalid"
          ],
          "open_material_decisions": 0,
          "material_assumptions": 0,
          "mode": "STANDARD"
        }
      }
    },
    {
      "id": "rubric-change-requires-revalidation",
      "kind": "accept",
      "behavior": "Changing the locked rubric between brief versions is a material change that forces downstream revalidation.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "delta",
      "args": [
        {
          "objective": "Explain how to read a website audit report",
          "audience": "marketing leads at small agencies",
          "deliverables": [
            "guide.md"
          ],
          "acceptance_criteria": [
            {
              "id": "ac1",
              "check": "every score in the guide links to its source table",
              "observable": true
            }
          ],
          "evidence_policy": "SOURCE_BOUND",
          "rubric_lock": {
            "pack_id": "editorial",
            "revision": "2",
            "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "locked_before_execution": true
          }
        },
        {
          "objective": "Explain how to read a website audit report",
          "audience": "marketing leads at small agencies",
          "deliverables": [
            "guide.md"
          ],
          "acceptance_criteria": [
            {
              "id": "ac1",
              "check": "every score in the guide links to its source table",
              "observable": true
            }
          ],
          "evidence_policy": "SOURCE_BOUND",
          "rubric_lock": {
            "pack_id": "editorial",
            "revision": "3",
            "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "locked_before_execution": true
          }
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "CHANGED",
          "material_changes": [
            "rubric_lock"
          ],
          "requires_downstream_revalidation": true,
          "errors": []
        }
      }
    },
    {
      "id": "non-material-change-is-unchanged",
