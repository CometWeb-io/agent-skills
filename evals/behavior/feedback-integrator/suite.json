    {
      "id": "repeatable-improvement-is-promoted",
      "kind": "accept",
      "behavior": "A challenger with repeatable improvements and no regressions on a frozen corpus is promoted.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "promotion",
      "args": [
        {
          "baseline_version": "1.2.0",
          "challenger_version": "1.3.0",
          "frozen_case_count": 40,
          "repeated_runs": 3,
          "improvements": 4,
          "regressions": 0,
          "evaluation_scope": "offline kernel suite"
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "PROMOTE",
          "errors": [],
          "reason": "repeatable-improvement-no-regression"
        }
      }
