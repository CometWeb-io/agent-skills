        "scripts/kernel.py"
      ],
      "call": "integrate",
      "args": [
        [
          {
            "pattern": "missing source locator",
            "severity": "MAJOR",
            "root_layer": "INSTRUCTION",
            "context_id": "a",
            "run_id": "run-a",
            "regression_test": {
              "id": "reg-locator-1",
              "assertion": "every SUPPORTED claim has a locator"
            }
          },
          {
            "pattern": "missing source locator",
            "severity": "MAJOR",
            "root_layer": "INSTRUCTION",
            "context_id": "b",
            "run_id": "run-b",
