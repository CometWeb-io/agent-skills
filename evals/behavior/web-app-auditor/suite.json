    {
      "id": "unsafe-production-ship-is-refused",
      "kind": "refuse",
      "behavior": "A production audit allowing test mutations, using sampled coverage at forensic depth and shipping a flow audit without a browser is rejected with each violation listed.",
      "run": [
        "scripts/validate_report.py",
        "{tmp}/audit-report.json",
        "--json"
      ],
      "files": {
        "audit-report.json": {
          "schemaVersion": "1.1",
          "target": "https://example.com",
          "mode": "flow",
          "depth": "forensic",
          "confidence": "high",
          "verdict": "ship",
          "capabilities": {
            "profile": "source",
            "browser": false,
            "source": true,
            "screenshots": false,
            "console": false,
            "network": false,
            "filesystem": true,
            "codeExecution": true
          },
          "environment": {
            "kind": "production",
            "mutationPolicy": "safe-test-only"
          },
          "scope": {
            "in": [
              "checkout"
            ],
            "out": [],
            "viewports": [],
            "persona": "anon",
            "covered": [],
            "skipped": []
          },
          "counts": {
            "blocker": 0,
            "major": 0,
            "minor": 0,
            "nit": 0,
            "needsRepro": 0,
            "recommendations": 0
          },
          "findings": [],
          "evidence": [],
          "coverage": {
            "totalInScope": 2,
            "tested": 1,
            "sampled": 1,
            "policyBlocked": 0,
            "environmentBlocked": 0,
            "unreachable": 0,
            "samplingRule": "sample"
          }
        }
      },
      "expect": {
        "exit_code": 1,
        "json": {
          "ok": false,
          "errors": [
            "production/unknown environment must use mutationPolicy='read-only'",
            "forensic depth cannot use sampled coverage",
            "interaction-heavy standard/forensic audit without browser must use verdict 'incomplete'"
          ],
          "warnings": []
        }
      }
    },
