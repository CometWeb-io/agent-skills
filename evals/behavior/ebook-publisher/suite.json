{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "ebook-publisher",
  "description": "Offline behavior of scripts/ebook_check.py init, fingerprints and validate as references/validation.md documents them; dates are pinned with --as-of.",
  "cases": [
    {
      "id": "init-creates-incomplete-draft",
      "kind": "accept",
      "behavior": "init creates a new publication workspace and reports it as an initialized draft that is not ready.",
      "run": [
        "scripts/ebook_check.py",
        "init",
        "{tmp}/new-publication"
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "result": "INITIALIZED_DRAFT",
          "path": "{tmp}/new-publication",
          "ready": false
        }
      }
    },
    {
      "id": "init-never-overwrites",
      "kind": "refuse",
      "behavior": "init refuses an existing directory instead of overwriting it.",
      "run": [
        "scripts/ebook_check.py",
        "init",
        "{tmp}/existing"
      ],
      "files": {
        "existing/notes.md": "keep me\n"
      },
      "expect": {
        "exit_code": 2,
        "json": {
          "result": "INPUT_ERROR",
          "error": "init requires a new nonexistent directory; nothing was overwritten"
        }
      }
    },
    {
