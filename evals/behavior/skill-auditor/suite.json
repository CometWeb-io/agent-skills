{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "skill-auditor",
  "description": "Offline behavior of the audit-record validator the references document as kernel.validate(audit), plus the bundled eval runner's command line.",
  "cases": [
    {
      "id": "clean-audit-passes-and-routes-to-evaluator",
      "kind": "accept",
      "behavior": "A clean audit with evidence for every material check passes, names the minor bump, and routes empirical proof to skill-evaluator without claiming it.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "validate",
      "args": [
        {
          "skill_id": "example-skill",
          "mode": "STANDARD",
          "version": "1.3.0",
          "previous_version": "1.2.4",
          "contract_compatibility": "BACKWARD_COMPATIBLE",
          "runtime_host_status": "REAL_HOST_VERIFIED",
          "runtime_support_claimed": true,
          "empirical_eval_required": true,
          "package": {
            "skill_md_lines": 120,
            "broken_references": 0,
            "unresolved_dependencies": 0,
            "forbidden_artifacts": 0,
            "symlinks": 0,
            "behavior_eval_cases": 8,
            "negative_routing_cases": 4,
            "runtime_host_claims": [
              "host-a"
            ],
            "runtime_verified_hosts": [
              "host-a"
            ],
            "branch_coverage": 0.97,
            "mutation_score": 0.85
          },
          "checks": [
            {
              "status": "PASS",
              "severity": "MAJOR",
              "material": true,
              "evidence": [
                "scripts/kernel.py:12"
              ]
            },
            {
              "status": "N_A",
              "rationale": "skill ships no network code"
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "PASS",
          "errors": [],
          "issues": [],
          "unknown_material": 0,
          "next_skill": "skill-evaluator",
          "version_bump": "MINOR",
          "migration_required": false,
          "empirical_effectiveness_proven": false
        }
      }
    },
    {
