              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-1",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ]
            }
          ],
          "findings": [
            {
              "severity": "MAJOR"
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "NOT_READY",
          "errors": []
        }
      }
    },
    {
      "id": "expired-waiver-is-not-a-control",
      "kind": "refuse",
      "behavior": "A waiver that expired before the evaluation time cannot carry the artifact to READY_WITH_CONTROLS.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-1",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ]
            }
          ],
          "as_of": "2026-09-10T00:00:00Z",
          "controls": [
            {
              "severity": "NOTE",
              "issue": "alt text wording",
              "owner": "editor",
              "revisit_condition": "next revision",
              "waiver": true,
              "approver": "owner@example.com",
              "approved_at": "2026-08-01T00:00:00Z",
              "expires_at": "2026-09-01T00:00:00Z"
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "NOT_READY",
          "errors": [
            "control[0]:expired"
          ]
        }
      }
    },
    {
      "id": "policy-hash-mismatch-defers",
      "kind": "boundary",
      "behavior": "A policy lock whose hash differs from the expected frozen policy defers the verdict instead of judging against a moved rubric.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-1",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ]
            }
          ],
          "policy_lock": {
            "pack_id": "editorial",
            "revision": "3",
            "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "locked_before_evaluation": true
          },
          "expected_policy_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "DEFER",
          "errors": [
            "policy-lock:hash-mismatch"
          ]
        }
      }
    },
    {
      "id": "evidence-grade-below-floor-defers",
      "kind": "boundary",
      "behavior": "A required PASS whose evidence grade is below the policy floor is not enough for READY.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-1",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ],
              "evidence_grade": "C"
            }
          ],
          "minimum_gate_evidence_grade": "B"
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "DEFER",
          "errors": [
            "gate[0]:evidence-grade-below-floor"
          ]
        }
      }
    },
    {
      "id": "required-na-needs-allowance-and-rationale",
