    {
      "id": "deep-mode-needs-traceability",
      "kind": "boundary",
      "behavior": "In DEEP mode every acceptance criterion must trace to a gate; an unmapped criterion is reported.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-1",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ]
            }
          ],
          "mode": "DEEP",
          "criteria_ids": [
            "c1",
            "c2"
          ],
          "traceability": [
            {
              "criterion_id": "c1",
              "gate_id": "brief_compliance"
            }
          ]
        }
