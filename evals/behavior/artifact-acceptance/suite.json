{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "artifact-acceptance",
  "description": "Offline behavior of the acceptance gate kernel the references document as kernel.decide(payload), and of the bundled eval runner.",
  "cases": [
    {
      "id": "evidenced-pass-is-ready",
      "kind": "accept",
      "behavior": "A required gate that passes with evidence bound to the same candidate makes the artifact READY.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-1",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ]
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "READY",
          "errors": [],
          "profile": "CUSTOM",
          "mode": "STANDARD"
        }
      }
    },
    {
      "id": "bounded-minor-control-is-ready-with-controls",
      "kind": "accept",
      "behavior": "A complete MINOR control with owner and revisit condition yields READY_WITH_CONTROLS rather than hiding the residual.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-1",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ]
            }
          ],
          "controls": [
            {
              "severity": "MINOR",
              "issue": "one caption wording",
              "owner": "editor",
              "revisit_condition": "next revision"
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "READY_WITH_CONTROLS",
          "errors": [],
          "profile": "CUSTOM",
          "mode": "STANDARD"
        }
      }
    },
    {
      "id": "failed-required-gate-is-not-ready",
      "kind": "refuse",
      "behavior": "A failed required gate makes the artifact NOT_READY even when a control is offered.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "FAIL"
            }
          ],
          "controls": [
            {
              "severity": "MINOR",
              "issue": "x",
              "owner": "editor",
              "revisit_condition": "later"
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "NOT_READY",
          "errors": []
        }
      }
    },
    {
      "id": "evidence-from-another-candidate-defers",
      "kind": "refuse",
      "behavior": "A PASS backed by evidence observed on a different candidate is not admissible and the verdict is deferred.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
              "required": true,
              "state": "PASS",
              "evidence": [
                {
                  "source": "render-check.log",
                  "locator": "line 3",
                  "candidate_id": "doc-0",
                  "observed_at": "2026-09-01T10:00:00Z"
                }
              ]
            }
          ]
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "verdict": "DEFER",
          "errors": [
            "gate[0]:pass-without-candidate-evidence"
          ]
        }
      }
    },
    {
      "id": "open-major-finding-blocks",
      "kind": "refuse",
      "behavior": "An open MAJOR finding blocks acceptance although every required gate passed.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "decide",
      "args": [
        {
          "candidate": {
            "id": "doc-1"
          },
          "contract": {
            "id": "brief-1"
          },
          "gates": [
            {
              "gate_id": "brief_compliance",
