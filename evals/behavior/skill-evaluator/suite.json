{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "skill-evaluator",
  "description": "Offline behavior of the experiment-report validator the references document as kernel.validate(report), plus the bundled eval runner's command line.",
  "cases": [
    {
      "id": "measured-lift-within-budget-is-improved",
      "kind": "accept",
      "behavior": "A same-suite run that beats the baseline by more than the margin, keeps trigger quality and stays inside the cost budget is IMPROVED and promotion-eligible.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "validate",
      "args": [
        {
          "skill_id": "example-skill",
          "candidate_version": "1.4.0",
          "baseline_version": "1.3.0",
          "mode": "STANDARD",
          "execution_mode": "LOCAL_DETERMINISTIC",
          "rubric_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "benchmark_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "suite_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "baseline_suite_hash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "declared_case_ids": [
            "t1",
            "t2",
            "t3",
            "t4"
          ],
          "executed_case_ids": [
            "t4",
            "t3",
            "t2",
            "t1"
          ],
          "negative_control_count": 1,
          "discovery_case_count": 2,
          "forced_case_count": 2,
          "runs_per_case": 1,
          "runtime_executed": true,
          "candidate": {
            "passed": 19,
            "total": 20,
            "trigger_tp": 9,
            "trigger_fp": 0,
            "trigger_fn": 1,
            "tokens": 1200,
            "duration_s": 30
          },
          "baseline": {
            "passed": 15,
            "total": 20,
            "trigger_tp": 8,
            "trigger_fp": 1,
            "trigger_fn": 1,
            "tokens": 1000,
            "duration_s": 25
          }
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "IMPROVED",
          "errors": [],
          "promotion_eligible": true,
          "empirical_claim_allowed": true,
          "pass_rate_delta": 0.2,
          "trigger_precision": 1.0,
          "trigger_recall": 0.9,
          "token_ratio": 1.2,
          "duration_ratio": 1.2,
          "paired_status": "NOT_USED",
          "stability_status": "NOT_USED"
        }
      }
    },
