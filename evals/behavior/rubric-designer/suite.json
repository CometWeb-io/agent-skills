{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "rubric-designer",
  "description": "Offline behavior of the rubric validator the references document as kernel.validate(rubric), plus the bundled eval runner's command line.",
  "cases": [
    {
      "id": "frozen-rubric-is-ready-and-hashed",
      "kind": "accept",
      "behavior": "A complete, candidate-blind rubric frozen before review is READY_TO_FREEZE with its SHA-256 lock and blocker count.",
      "run": [
        "scripts/kernel.py"
      ],
      "call": "validate",
      "args": [
        {
          "rubric_id": "pricing-brief",
          "revision": "r1",
          "purpose": "grade pricing briefs before publication",
          "target_type": "pricing brief",
          "mode": "STANDARD",
          "candidate_blind": true,
          "frozen_before_review": true,
          "required_dimensions": [
            "accuracy",
            "clarity"
          ],
          "criteria": [
            {
              "id": "c1",
              "dimension": "accuracy",
              "description": "Prices match the live pricing page",
              "observable": true,
              "pass_condition": "every listed price matches the pricing page",
              "fail_condition": "any listed price differs from the pricing page",
              "evidence_floor": "A",
              "materiality": "critical",
              "blocker": true,
              "weight": 0.6
            },
            {
              "id": "c2",
              "dimension": "clarity",
              "description": "Each section opens with its conclusion",
              "observable": true,
              "pass_condition": "each section states its conclusion in the first sentence",
              "fail_condition": "a section buries its conclusion",
              "evidence_floor": "C",
              "materiality": "supporting",
              "weight": 0.4
            }
          ],
          "anti_gaming": {
            "no_hidden_criteria": true,
            "no_post_hoc_changes": true
          }
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "status": "READY_TO_FREEZE",
          "errors": [],
          "rubric_hash": "9c4b6015b6b282f33909d68a2cda2560a36249948fe5006eb6fe30bc87e0c0c2",
          "criteria_count": 2,
          "blocker_count": 1,
          "missing_dimensions": [],
          "frozen": true
        }
      }
    },
