{
  "schema": "cometweb.behavior-suite/v1",
  "skill": "seo-geo-aeo-maxxing",
  "description": "Offline behavior of build_audit_template.py, score_maxx.py, compare_scores.py and check_freshness.py as SKILL.md and references/scoring.md tell a user to run them.",
  "cases": [
    {
      "id": "template-for-one-pillar",
      "kind": "accept",
      "behavior": "A PILLAR template for AEO lists every AEO check as NOT_ASSESSED with what evidence is needed, so nothing is scored by default.",
      "run": [
        "scripts/build_audit_template.py",
        "--mode",
        "PILLAR",
        "--pillars",
        "aeo",
        "--surfaces",
        "chatgpt-search",
        "--subject",
        "https://example.com/"
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "registry_version": "3.0.0",
          "mode": "PILLAR",
          "active_pillars": [
            "aeo"
          ],
          "target_surfaces": [
            "chatgpt-search"
          ],
          "subject": "https://example.com/",
          "gates": [],
          "checks.0": {
            "id": "AEO-01",
            "verdict": "NOT_ASSESSED",
            "needed": "Collect evidence for: Answer-first clarity"
          }
        },
        "json_len": {
          "checks": 7
        }
      }
    },
    {
      "id": "pillar-template-without-pillars-is-refused",
      "kind": "refuse",
      "behavior": "Asking for a PILLAR audit without naming the pillars is refused with a usage error.",
      "run": [
        "scripts/build_audit_template.py",
        "--mode",
        "PILLAR"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_contains": [
          "error: PILLAR mode requires --pillars"
        ]
      }
    },
