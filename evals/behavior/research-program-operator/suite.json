                "evidence_requirement": "powered follow-up observations",
                "stop_rule": "stop at preregistered sample size",
                "continue_rule": "continue after ethics approval"
              }
            ],
            "governance": [],
            "unknowns": []
          },
          "research_handoff": {
            "status": "READY",
            "target": "longform-publisher"
          }
        }
      ],
      "expect": {
        "exit_code": 0,
        "json": {
          "$": []
        }
      }
    },
