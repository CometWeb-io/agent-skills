        "0000000000000000000000000000000000000000"
      ],
      "files": {
        "tree.json": {
          "sha": "dad39ed38cd6dbbe15f3db3ed2d584b0432e1783",
          "truncated": false,
          "tree": [
            {
              "path": "README.md",
              "mode": "100644",
              "type": "blob",
              "sha": "b4f04f43841a9645a9faf665a65270ce2e8051b3"
            },
            {
              "path": "src",
              "mode": "040000",
              "type": "tree",
              "sha": "5f6ed9bfb37c89a89c650f1d713723d459bfcdd9"
            },
            {
              "path": "src/app.py",
              "mode": "100644",
              "type": "blob",
