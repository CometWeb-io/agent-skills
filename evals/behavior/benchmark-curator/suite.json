        "cases": [
          {
            "id": "c1",
            "class": "discovery",
            "difficulty": "medium",
            "split": "dev",
            "contamination_status": "CLEAN",
            "source_lane": "REAL_TASK",
            "prompt": "Review this draft against its brief.",
            "expected_behavior": "routes to the skill",
            "assertions": [
              "names the skill"
            ]
          },
          {
            "id": "c2",
            "class": "negative-control",
            "difficulty": "medium",
            "split": "holdout",
            "contamination_status": "CLEAN",
            "source_lane": "SYNTHETIC",
            "prompt": "What is the capital of France?",
            "expected_behavior": "routes to the skill",
            "assertions": [
              "names the skill"
            ]
          }
        ]
      },
      "expect": {
        "exit_code": 1,
        "json": {
          "status": "INVALID",
          "errors": [
            "cases[0]:provenance_ref"
          ]
        }
      }
    },
    {
      "id": "missing-required-class-needs-rebalance",
      "kind": "boundary",
      "behavior": "A benchmark lacking a required class is sent back for rebalancing, not rejected as malformed.",
      "run": [
        "scripts/kernel.py",
        "{input}"
      ],
      "input": {
        "benchmark_id": "bench-demo",
        "revision": "1",
        "objective": "routing precision",
        "target_skill": "example-skill",
        "required_classes": [
          "discovery",
          "negative-control",
          "adversarial"
        ],
        "cases": [
          {
            "id": "c1",
            "class": "discovery",
            "difficulty": "medium",
            "split": "dev",
            "contamination_status": "CLEAN",
            "source_lane": "SYNTHETIC",
            "prompt": "Review this draft against its brief.",
            "expected_behavior": "routes to the skill",
            "assertions": [
              "names the skill"
            ]
          },
          {
            "id": "c2",
            "class": "negative-control",
            "difficulty": "medium",
            "split": "holdout",
            "contamination_status": "CLEAN",
            "source_lane": "SYNTHETIC",
            "prompt": "What is the capital of France?",
            "expected_behavior": "routes to the skill",
            "assertions": [
              "names the skill"
            ]
          }
        ]
      },
      "expect": {
        "exit_code": 1,
        "json": {
          "status": "NEEDS_REBALANCE",
          "errors": [
            "classes:missing"
          ],
          "missing_classes": [
            "adversarial"
          ]
        }
      }
    },
    {
      "id": "deep-without-leakage-scan-needs-revision",
      "kind": "boundary",
      "behavior": "A DEEP benchmark cannot freeze until a corpus leakage scan is supplied.",
      "run": [
        "scripts/kernel.py",
        "{input}"
      ],
      "input": {
        "benchmark_id": "bench-demo",
        "revision": "1",
        "objective": "routing precision",
        "target_skill": "example-skill",
        "required_classes": [
          "discovery",
          "negative-control"
        ],
        "cases": [
          {
            "id": "c1",
            "class": "discovery",
            "difficulty": "medium",
            "split": "holdout",
            "contamination_status": "CLEAN",
            "source_lane": "SYNTHETIC",
            "prompt": "Review this draft against its brief.",
            "expected_behavior": "routes to the skill",
            "assertions": [
              "names the skill"
            ]
          },
          {
            "id": "c2",
            "class": "negative-control",
            "difficulty": "medium",
            "split": "holdout",
            "contamination_status": "CLEAN",
            "source_lane": "SYNTHETIC",
            "prompt": "What is the capital of France?",
            "expected_behavior": "routes to the skill",
            "assertions": [
              "names the skill"
            ]
          }
        ],
        "mode": "DEEP"
      },
      "expect": {
        "exit_code": 1,
        "json": {
          "status": "NEEDS_REVISION",
          "errors": [
            "deep:leakage-scan-required"
          ],
          "split_counts": {
            "dev": 0,
            "holdout": 2
          }
        }
      }
    },
