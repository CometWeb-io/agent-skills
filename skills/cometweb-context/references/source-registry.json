{
  "schema": "cometweb.source-registry/v1",
  "notes": "Claim-specific source authority. Resolve live customer bindings at runtime; never store credentials or customer records here.",
  "authority_levels": [
    "system_of_record",
    "canonical",
    "primary",
    "secondary",
    "fallback"
  ],
  "profiles": {
    "product": {
      "preferred_source_groups": [
        "github-product",
        "insight",
        "vault-status",
        "vault-decisions"
      ]
    },
    "portfolio": {
      "preferred_source_groups": [
        "github-portfolio",
        "notion",
        "vault-status",
        "vault-decisions",
        "insight"
      ]
    },
    "gtm": {
      "preferred_source_groups": [
        "vault-decisions",
        "vault-first-principles",
        "vault-topic",
        "website",
        "crm-when-material"
      ]
    },
    "outreach": {
      "preferred_source_groups": [
        "crm",
        "communications",
        "vault-icp-sop",
        "prospect-web"
      ]
    },
    "brand": {
      "preferred_source_groups": [
        "vault-brand",
        "evidence-register",
        "public-profiles",
        "website"
      ]
    },
    "meeting": {
      "preferred_source_groups": [
        "calendar",
        "contacts",
        "crm-or-communications",
        "relevant-docs"
      ]
    },
    "weekly": {
      "preferred_source_groups": [
        "github-portfolio",
        "insight",
        "vault",
        "crm",
        "notion",
        "communications-when-relevant",
        "website"
      ]
    },
    "claim-verification": {
      "preferred_source_groups": [
        "evidence-register",
        "primary-claim-source",
        "publication-surface"
      ]
    },
    "custom": {
      "preferred_source_groups": []
    }
  },
  "domains": {
    "product": {
      "hierarchy": [
        "pinned release/CI artifact",
        "github head",
        "local checkout",
        "docs/notion intent"
      ]
    },
    "governance": {
      "bindings": [
        {
          "id": "first-principles",
          "role": "canonical_decision_input",
          "local_path_template": "<set-in-source-registry.local.json:first-principles>",
          "decision_alias": "<internal-alias>",
          "alias_map_template": "<set-in-source-registry.local.json:first-principles>",
          "note": "Retrieve when material new decision; never allocate decisions from context skill"
        }
      ]
    },
    "crm": {
      "binding": "external",
      "resolver": "runtime",
      "required_role": "system_of_record",
      "fallback_policy": "authority_gap",
      "note": "Concrete SoR lives in private runtime bindings; do not silently replace it with another available connector"
    },
    "claims": {
      "evidence_register_template": "<set-in-source-registry.local.json:evidence-register>",
      "public_use_gate": true
    }
  },
  "repo_registry_file": "references/repos.txt"
}
