    "checks.status": {
      "enum": [
        "FAIL",
        "N_A",
        "PASS",
        "UNKNOWN"
      ]
    },
    "checks.severity": {
      "enum": [
        "BLOCKER",
        "MAJOR",
        "MINOR",
        "NOTE"
      ]
    },
    "material": {},
    "evidence": {},
    "rationale": {},
    "deep_checks": {},
    "topology_inventory": {},
    "trigger_overlap": {},
    "reference_integrity": {},
    "dependency_graph": {},
    "executable_coverage": {},
    "package_unpacked": {},
    "supply_chain": {},
    "host_claims": {},
    "version_contracts": {}
