  "outputs": {
    "status": {
      "enum": [
        "CHANGES_REQUIRED",
        "DEFER",
        "INVALID",
        "PASS"
      ]
    },
    "errors": {},
    "issues": {},
    "unknown_material": {},
    "next_skill": {},
    "version_bump": {},
    "migration_required": {},
    "empirical_effectiveness_proven": {}
  },
  "internal": [
    "input"
  ],
  "doc_terms": [],
  "evals": [
    {
      "path": "evals/cases.json",
      "cases": "",
      "input": "input",
      "status": "expect.status",
      "pass": [
        "CHANGES_REQUIRED",
        "DEFER",
        "PASS"
      ]
    }
  ]
}
