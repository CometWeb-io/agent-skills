{
  "schema": "cometweb.skill-contract/v1",
  "docs": [
    "references/output-contract.md"
  ],
  "scripts": {
    "scripts/kernel.py": {
      "input": "json",
      "role": "kernel",
      "enums": {
        "MODES": "mode",
        "COMPAT": "contract_compatibility",
        "HOST_STATUS": "runtime_host_status",
        "CHECK_STATUSES": "checks.status",
        "SEVERITIES": "checks.severity"
      }
    },
    "scripts/run_evals.py": {
      "input": "none",
      "role": "eval-harness"
    }
  },
  "fields": {
    "skill_id": {},
    "mode": {
