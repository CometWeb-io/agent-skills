      "enum": [
        "BACKWARD_COMPATIBLE",
        "BREAKING",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "migration_guide_present": {},
    "migration_plan": {},
    "consumer_actions": {},
    "rollback_ref": {},
    "verification_cases": {},
    "runtime_host_status": {
      "enum": [
        "DEGRADED",
        "REAL_HOST_VERIFIED",
        "STATIC_SHAPE_ONLY",
        "UNKNOWN",
        "UNSUPPORTED"
      ]
    },
    "runtime_support_claimed": {},
    "empirical_eval_required": {},
    "package": {},
    "skill_md_lines": {},
    "broken_references": {},
    "unresolved_dependencies": {},
    "forbidden_artifacts": {},
    "symlinks": {},
    "behavior_eval_cases": {},
    "negative_routing_cases": {},
    "runtime_host_claims": {},
    "runtime_verified_hosts": {},
    "branch_coverage": {},
    "mutation_score": {},
