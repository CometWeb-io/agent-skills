{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-report.schema.json",
  "title": "WebAppAuditorReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "target", "mode", "depth", "confidence", "verdict",
    "capabilities", "environment", "scope", "counts", "findings", "evidence",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "target": {"type": "string", "minLength": 1},
    "mode": {"enum": ["page", "area", "crawl", "flow", "data", "visual", "regression", "a11y", "contract-trace"]},
    "depth": {"enum": ["recon", "standard", "forensic"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "verdict": {"enum": ["do_not_ship", "ship_with_fixes", "ship", "incomplete"]},
    "validator": {"enum": ["passed", "warnings", "not run"]},
    "contractTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace", "result"],
      "properties": {
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "revision", "build", "environment", "journey_id", "claim", "nodes", "evidence", "edges", "scenarios"],
          "properties": {
            "schema": {"const": "cometweb.contract-trace/v1"},
            "revision": {"type": "string", "minLength": 1},
            "build": {"type": "string", "minLength": 1},
            "environment": {"type": "string", "minLength": 1},
            "journey_id": {"type": "string", "minLength": 1},
            "claim": {"enum": ["bounded", "incomplete"]},
            "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}}},
            "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "channel", "locator"], "properties": {"id": {"type": "string", "minLength": 1}, "channel": {"enum": ["browser", "backend", "joined"]}, "locator": {"type": "string", "minLength": 1}}}},
            "edges": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "from", "to", "kind", "state", "evidence_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "state": {"enum": ["pass", "fail", "unknown", "blocked"]}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
            "scenarios": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "status", "evidence_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["happy", "null_partial", "retry_duplicate", "wrong_tenant", "rollback"]}, "status": {"enum": ["pass", "fail", "unknown", "blocked"]}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "status", "result", "errors"],
          "properties": {
            "schema": {"const": "cometweb.contract-trace-result/v1"},
            "status": {"enum": ["VALID", "INVALID"]},
            "result": {"enum": ["complete", "incomplete"]},
            "errors": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "browser", "source", "screenshots", "console", "network", "filesystem", "codeExecution"],
      "properties": {
        "profile": {"enum": ["hybrid", "browser", "screenshot", "source", "fetch-only"]},
        "browser": {"type": "boolean"},
        "source": {"type": "boolean"},
        "screenshots": {"type": "boolean"},
        "console": {"type": "boolean"},
        "network": {"type": "boolean"},
        "filesystem": {"type": "boolean"},
        "codeExecution": {"type": "boolean"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mutationPolicy"],
      "properties": {
        "kind": {"enum": ["production", "staging", "test", "local", "unknown"]},
        "mutationPolicy": {"enum": ["read-only", "safe-test-only"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out", "viewports", "persona", "covered", "skipped"],
      "properties": {
        "in": {"type": "array", "items": {"type": "string"}},
        "out": {"type": "array", "items": {"type": "string"}},
        "viewports": {"type": "array", "items": {"type": "string"}},
        "persona": {"type": "string"},
        "covered": {"type": "array", "items": {"type": "string"}},
        "skipped": {"type": "array", "items": {"type": "string"}},
        "stopReason": {"type": "string"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "major", "minor", "nit", "needsRepro", "recommendations"],
      "properties": {
        "blocker": {"type": "integer", "minimum": 0},
        "major": {"type": "integer", "minimum": 0},
        "minor": {"type": "integer", "minimum": 0},
        "nit": {"type": "integer", "minimum": 0},
        "needsRepro": {"type": "integer", "minimum": 0},
        "recommendations": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "location", "supports", "redacted"],
        "properties": {
          "id": {"type": "string", "pattern": "^E-[0-9]{3}$"},
          "type": {"enum": ["screenshot", "dom", "text", "arithmetic", "console", "network", "source"]},
          "location": {"type": "string"},
          "supports": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{3}$"}},
          "redacted": {"enum": ["yes", "no", "n/a"]}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalInScope", "tested", "sampled", "policyBlocked", "environmentBlocked", "unreachable"],
      "properties": {
        "totalInScope": {"type": "integer", "minimum": 0},
        "tested": {"type": "integer", "minimum": 0},
        "sampled": {"type": "integer", "minimum": 0},
        "policyBlocked": {"type": "integer", "minimum": 0},
        "environmentBlocked": {"type": "integer", "minimum": 0},
        "unreachable": {"type": "integer", "minimum": 0},
        "samplingRule": {"type": "string"}
      }
    },
    "contradictionMatrix": {"type": "array"},
    "outOfScope": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "recommendedNextAudit": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "contract-trace"}}, "required": ["mode"]}, "then": {"required": ["contractTrace"]}},
    {"if": {"required": ["contractTrace"]}, "then": {"properties": {"mode": {"const": "contract-trace"}}}}
  ]
}
