{
  "schema": "cometweb.skill-contract/v1",
  "docs": [
    "references/workflow-archetypes.md",
    "references/run-ledger-contract.md"
  ],
  "scripts": {
    "scripts/orchestrate_kernel.py": {
      "input": "args",
      "role": "kernel",
      "enums": {
        "ARCHETYPES": "archetype",
        "ENVELOPE_TYPES": "envelope_out"
      }
    },
    "scripts/workflow_ledger.py": {
      "input": "args",
      "role": "kernel",
      "enums": {
        "RUN_STATES": "status"
      }
    }
  },
  "fields": {
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "COMPLETED",
        "STALE_PLAN"
      ]
    },
    "run_id": {},
    "step_id": {},
    "event_type": {},
    "event_hash": {},
    "plan_hash": {},
    "envelope_id": {},
    "envelope_hash": {}
  },
  "outputs": {
    "archetype": {
      "enum": [
        "research_then_council",
        "research_then_operator",
        "audit_then_release",
        "competitive_then_council",
        "orchestrated_goal",
        "single_skill",
        "disambiguate_only"
      ]
    },
    "goal_summary": {},
    "steps": {},
    "skill": {},
    "purpose": {},
    "envelope_out": {
      "enum": [
        "EvidenceEnvelope",
        "DecisionHandoff",
        "FindingEnvelope",
        "SpecialistHandoff",
        "SnapshotMetadata"
      ]
    },
    "read_skill": {},
    "boundaries": {},
    "single_skill_alternative": {}
  },
  "internal": {
    "orchestrated_goal": "intent label the router assigns from its own patterns",
    "schema": "ledger envelope discriminator",
    "data": "event payload stored in the local ledger",
    "execution_mode": "run manifest execution mode",
    "previous_event_hash": "hash-chain predecessor",
    "seq": "append-only event sequence"
  },
  "doc_terms": [],
  "evals": []
}
