{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "GO",
        "NO-GO",
        "TEST",
        "DEFER"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "required_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "critical_gap": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "CLEAR",
        "UNKNOWN",
        "REFRESH_REQUIRED"
      ]
    },
    "controls_implemented": {
      "type": "boolean"
    },
    "reversible_experiment_available": {
      "type": "boolean"
    },
    "experiment": {
      "type": "object",
      "properties": {
        "hypothesis": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pass_threshold": {
          "type": "string"
        },
        "fail_threshold": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "budget": {
          "type": "string"
        },
        "sample": {
          "type": "string"
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kill_criteria": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "review_date": {
          "type": "string"
        }
      },
      "required": [
        "hypothesis",
        "metric",
        "baseline",
        "pass_threshold",
        "fail_threshold",
        "duration",
        "budget",
        "sample",
        "guardrails",
        "kill_criteria",
        "owner",
        "review_date"
      ],
      "additionalProperties": false
    },
    "minority_report": {
      "type": "string"
    },
    "independence_grade": {
      "type": "string",
      "enum": [
        "I1"
      ]
    },
    "memory_written": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "verdict",
    "confidence",
    "required_confidence",
    "reason",
    "blockers",
    "controls",
    "critical_gap",
    "freshness_status",
    "controls_implemented",
    "reversible_experiment_available",
    "experiment",
    "minority_report",
    "independence_grade",
    "memory_written"
  ],
  "additionalProperties": false
}
