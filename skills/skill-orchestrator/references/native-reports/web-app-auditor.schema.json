{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebAppAuditorReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "mode",
    "depth",
    "confidence",
    "verdict",
    "capabilities",
    "environment",
    "scope",
    "counts",
    "findings",
    "evidence",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "page"
      ]
    },
    "depth": {
      "type": "string",
      "enum": [
        "standard"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "incomplete"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "browser",
        "source",
        "screenshots",
        "console",
        "network",
        "filesystem",
        "codeExecution"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "source"
          ]
        },
        "browser": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "source": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "screenshots": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "console": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "network": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "filesystem": {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        "codeExecution": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mutationPolicy"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local"
          ]
        },
        "mutationPolicy": {
          "type": "string",
          "enum": [
            "read-only"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in",
        "out",
        "viewports",
        "persona",
        "covered",
        "skipped",
        "stopReason"
      ],
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persona": {
          "type": "string"
        },
        "covered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stopReason": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker",
        "major",
        "minor",
        "nit",
        "needsRepro",
        "recommendations"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "nit": {
          "type": "integer",
          "minimum": 0
        },
        "needsRepro": {
          "type": "integer",
          "minimum": 0
        },
        "recommendations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "title": "WebAppAuditorFinding",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "severity",
          "confidence",
          "title",
          "where",
          "repro",
          "expected",
          "expectedBasis",
          "actual",
          "evidence",
          "impact",
          "rootCause",
          "suggestedFix"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3}$"
          },
          "kind": {
            "enum": [
              "defect",
              "usability-risk",
              "recommendation",
              "needs-repro"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "nit",
              "n/a"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "where": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route",
              "viewport",
              "persona"
            ],
            "properties": {
              "route": {
                "type": "string"
              },
              "viewport": {
                "type": "string"
              },
              "persona": {
                "type": "string"
              }
            }
          },
          "repro": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "expectedBasis": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "product-requirement",
                "user-instruction",
                "arithmetic",
                "observed-consistency",
                "API-contract",
                "accessibility-standard",
                "platform-convention",
                "heuristic"
              ]
            }
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3}$"
            }
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "rootCause": {
            "type": "string",
            "minLength": 1
          },
          "suggestedFix": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "location",
          "supports",
          "redacted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E-[0-9]{3}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "location": {
            "type": "string"
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F-[0-9]{3}$"
            }
          },
          "redacted": {
            "enum": [
              "yes",
              "no",
              "n/a"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalInScope",
        "tested",
        "sampled",
        "policyBlocked",
        "environmentBlocked",
        "unreachable",
        "samplingRule"
      ],
      "properties": {
        "totalInScope": {
          "type": "integer",
          "minimum": 0
        },
        "tested": {
          "type": "integer",
          "minimum": 0
        },
        "sampled": {
          "type": "integer",
          "minimum": 0
        },
        "policyBlocked": {
          "type": "integer",
          "minimum": 0
        },
        "environmentBlocked": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "minimum": 0
        },
        "samplingRule": {
          "type": "string"
        }
      }
    }
  }
}
