      "type": "string",
      "enum": [
        "2.2"
      ]
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "STANDARD"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "horizon": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mutations": {
      "type": "string",
      "enum": [
        "read-only"
