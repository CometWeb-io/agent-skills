    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": {
          "type": "string",
          "enum": [
            "verified",
            "partial",
            "unavailable",
            "not-required"
          ]
        },
        "notion": {
          "type": "string",
          "enum": [
            "verified",
            "partial",
            "unavailable",
            "not-required"
          ]
        },
        "product_context": {
