{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/science-roaster-v6.json",
  "title": "CometWeb Science Roaster v6 Report",
  "type": "object",
  "required": [
    "schema",
    "artifact",
    "review_outcome",
    "source_manifest",
    "mode",
    "evidence_mode",
    "study_profile",
    "study_contract",
    "coverage",
    "quality_gates",
    "measurement_chain",
    "claim_map",
    "validity_ledger",
    "analysis_integrity_ledger",
    "alternative_explanations",
    "robustness_ledger",
    "root_causes",
    "no_material_findings",
    "first_attack_id",
    "findings",
    "resolution_ledger",
    "external_verification_queue",
    "claim_survival",
    "survives",
    "minimal_surviving_claim",
    "core_fix",
    "review_plan",
    "assurance",
    "evidence_register",
    "evidence_conflicts",
    "limitations",
    "inferential_claim_ledger",
    "outcome_basis"
  ],
  "properties": {
    "schema": {
      "const": "cometweb.science-roaster/v6"
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "review_outcome": {
      "enum": [
        "MATERIAL_FINDINGS",
        "NO_MATERIAL_FINDINGS",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "source_manifest": {
      "type": "array",
      "minItems": 1
    },
    "mode": {
      "enum": [
        "QUICK",
        "FULL",
        "REVIEWER_2",
        "REVISION"
      ]
    },
    "evidence_mode": {
      "enum": [
        "SOURCE_BOUND",
        "VERIFY_EXTERNAL"
      ]
    },
    "study_profile": {
      "enum": [
        "EXPERIMENTAL",
        "OBSERVATIONAL",
        "PREDICTIVE",
        "VALIDATION",
        "METHODS",
        "COMPUTATIONAL",
        "REVIEW",
        "PROTOCOL",
        "MIXED"
      ]
    },
    "claim_map": {
      "type": "array",
      "minItems": 1
    },
    "validity_ledger": {
      "type": "array"
    },
    "analysis_integrity_ledger": {
      "type": "array"
    },
    "alternative_explanations": {
      "type": "array"
    },
    "robustness_ledger": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "claim_survival": {
      "type": "array"
    },
    "first_attack_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "no_material_findings": {
      "type": "boolean"
    },
    "minimal_surviving_claim": {
      "type": "string",
      "minLength": 1
    },
    "core_fix": {
      "type": "string",
      "minLength": 1
    },
    "review_plan": {
      "type": "object"
    },
    "assurance": {
      "type": "object",
      "required": [
        "mode",
        "independence",
        "second_pass_status",
        "disagreement_summary",
        "limitations",
        "pass_records"
      ],
      "properties": {
        "mode": {
          "enum": [
            "SINGLE_REVIEW",
            "SECOND_PASS",
            "BLIND_DUAL_REVIEW"
          ]
        },
        "independence": {
          "enum": [
            "NONE",
            "SAME_CONTEXT",
            "SEPARATE_CONTEXT"
          ]
        },
        "second_pass_status": {
          "type": "string"
        },
        "disagreement_summary": {
          "type": "array"
        },
        "limitations": {
          "type": "array"
        },
        "pass_records": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "evidence_register": {
      "type": "array",
      "minItems": 1
    },
    "evidence_conflicts": {
      "type": "array"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inferential_claim_ledger": {
      "type": "array",
      "minItems": 1
    },
    "outcome_basis": {
      "type": "object",
      "required": [
        "surviving_finding_ids",
        "withdrawn_candidate_count",
        "unresolved_candidate_count",
        "reason"
      ],
      "properties": {
        "surviving_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "withdrawn_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
