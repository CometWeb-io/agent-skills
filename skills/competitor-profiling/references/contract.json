    "scope": {},
    "sources": {},
    "id": {},
    "kind": {},
    "locator": {},
    "observed_at": {},
    "claims": {},
    "text": {},
    "state": {},
    "source_ids": {},
    "sections": {},
    "company": {},
    "icp": {},
    "positioning": {},
    "product": {},
    "pricing": {},
    "proof": {},
    "discovery": {},
    "contradictions": {},
    "gaps": {},
    "competitive_intelligence_handoff": {},
    "baseline_id": {},
    "source_profile_status": {
      "enforced": false,
      "enum": [
        "BOOTSTRAP",
        "PARTIAL",
        "READY"
      ]
    }
  },
  "outputs": {},
  "internal": {},
  "doc_terms": [],
  "evals": [
    {
      "path": "evals/cases.json",
      "cases": "",
      "input": "input",
      "errors": "expected_errors",
      "pass": [
        "pass"
      ]
    }
  ]
