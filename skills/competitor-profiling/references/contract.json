{
  "schema": "cometweb.skill-contract/v1",
  "docs": [
    "references/output-contract.md"
  ],
  "scripts": {
    "scripts/output_contract.py": {
      "input": "json",
      "role": "validator",
      "enums": {
        "STATUSES": "status"
      }
